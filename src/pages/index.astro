---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
---

<BaseLayout>
  <main class="container-responsive py-10 sm:py-16">
    <!-- Hero -->
    <section class="grid items-center gap-10 sm:grid-cols-2">
      <div class="space-y-6">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Choose the Best Membership Deal. Use It More.</h1>
        <p class="text-lg text-slate-600 dark:text-slate-300">Compare any membership pass or subscription. Track your usage to maximize savings and get your money's worth from every purchase.</p>
        <div class="flex gap-3">
          <a href="https://apps.apple.com/us/app/passworth/id6753592317" target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-lg bg-primary px-5 py-3 text-white shadow hover:bg-primary-600 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 dark:focus:ring-offset-slate-900">Get the App</a>
          <a href="#how-it-works" class="inline-flex items-center rounded-lg border border-slate-300 px-5 py-3 text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">See how it works</a>
        </div>
      </div>
      <div class="relative">
        <img
          src="/images/hero.png"
          alt="PassWorth membership tracker app showing gym and fitness pass cost comparison and usage tracking"
          width="1152" height="768"
          loading="eager" fetchpriority="high"
          class="block w-full rounded-2xl shadow-sm"
        />
      </div>
    </section>

    <!-- Features -->
    <section class="mt-24 grid gap-8 sm:grid-cols-3">
      <div class="rounded-xl border border-slate-200 p-6 dark:border-slate-800">
        <div class="mb-4 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Find the best deal">
            <path d="M3 7h10" />
            <path d="M3 15h18" />
            <path d="M3 11.1h18" opacity=".25"/>
          </svg>
        </div>
        <h3 class="mb-2 text-xl font-semibold">Find the Best Deal</h3>
        <p class="text-slate-600 dark:text-slate-300">Compare punch cards and time-based passes side by side. See which membership subscription offers the most value for your budget.</p>
      </div>
      <div class="rounded-xl border border-slate-200 p-6 dark:border-slate-800">
        <div class="mb-4 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Track usage and maximize value">
            <circle cx="12" cy="12" r="7" opacity=".25"/>
            <path d="M12 5a7 7 0 0 1 6.06 3.5" />
            <path d="M14.5 12l3 0m-1.5-1.5l1.5 1.5l-1.5 1.5" />
          </svg>
        </div>
        <h3 class="mb-2 text-xl font-semibold">Track Usage & Maximize Value</h3>
        <p class="text-slate-600 dark:text-slate-300">Monitor your visits with progress tracking. See your cost per visit and break-even point to motivate you to use your membership more.</p>
      </div>
      <div class="rounded-xl border border-slate-200 p-6 dark:border-slate-800">
        <div class="mb-4 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Save money on subscriptions">
            <ellipse cx="8" cy="16" rx="4.5" ry="2" />
            <path d="M3.5 16v2c0 1.1 2 2 4.5 2s4.5-.9 4.5-2v-2" />
            <path d="M14 10l2.5 2.5L21 8" />
          </svg>
        </div>
        <h3 class="mb-2 text-xl font-semibold">Maximize Your Savings</h3>
        <p class="text-slate-600 dark:text-slate-300">Calculate total savings across all your memberships. Make smart financial decisions on gym, yoga, and climbing expenses.</p>
      </div>
    </section>

    <!-- Demo / Calculator -->
    <div id="how-it-works">
      <Calculator />
    </div>

    <!-- Social Proof placeholder -->
    <section class="mt-24 grid gap-6 sm:grid-cols-3">
      <div class="rounded-xl border border-slate-200 p-6 dark:border-slate-800">
        <p class="text-slate-700 dark:text-slate-200">"Finally found the best deal on my gym membership. The comparison made it so clear!"</p>
        <p class="mt-2 text-sm text-slate-500">Sarah - Fitness enthusiast</p>
      </div>
      <div class="rounded-xl border border-slate-200 p-6 dark:border-slate-800">
        <p class="text-slate-700 dark:text-slate-200">"Tracking my climbing pass usage motivates me to go more often. Already saved $200 this year!"</p>
        <p class="mt-2 text-sm text-slate-500">Mike - Climbing enthusiast</p>
      </div>
      <div class="rounded-xl border border-slate-200 p-6 dark:border-slate-800">
        <p class="text-slate-700 dark:text-slate-200">"Worth every penny. I use my yoga membership way more now that I see my cost per visit."</p>
        <p class="mt-2 text-sm text-slate-500">Emma - Yoga practitioner</p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-24">
      <h2 class="text-2xl font-bold">Frequently Asked Questions</h2>
      <div class="mt-6 divide-y divide-slate-200 rounded-xl border border-slate-200 dark:divide-slate-800 dark:border-slate-800">
        <details class="group p-6 open:bg-slate-50 dark:open:bg-slate-800/40" open>
          <summary class="cursor-pointer list-none font-semibold">What is PassWorth and how does it help me save money?</summary>
          <p class="mt-3 text-slate-600 dark:text-slate-300">PassWorth is an iOS membership tracker app that helps you compare any membership pass costs. It shows you which subscription or punch card offers the best value, tracks your usage to maximize savings, and motivates you to use your memberships more often. Works great for gyms, studios, clubs, and any recurring membership service.</p>
        </details>
        <details class="group p-6">
          <summary class="cursor-pointer list-none font-semibold">Can I track multiple memberships at the same time?</summary>
          <p class="mt-3 text-slate-600 dark:text-slate-300">Yes! Track unlimited memberships across any subscription-based service with punch cards or time-based passes. Compare them all to see which gives you the best deal. Perfect for gyms, studios, clubs, classes, and more.</p>
        </details>
        <details class="group p-6">
          <summary class="cursor-pointer list-none font-semibold">How does usage tracking help me get more value?</summary>
          <p class="mt-3 text-slate-600 dark:text-slate-300">By showing your real-time cost per visit and break-even point, PassWorth motivates you to use your membership more frequently. The more you go, the lower your average cost becomes, maximizing your return on investment.</p>
        </details>
        <details class="group p-6">
          <summary class="cursor-pointer list-none font-semibold">Does it support different currencies and pricing models?</summary>
          <p class="mt-3 text-slate-600 dark:text-slate-300">Yes. Set your preferred currency in settings. PassWorth works with all pricing models including monthly subscriptions, annual memberships, punch cards, and pay-per-visit options.</p>
        </details>
      </div>
    </section>

    <!-- CTA -->
    <section class="mt-24 text-center">
      <h2 class="text-3xl font-bold">Make Every Membership Worth It.</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">Start tracking your gym, fitness, and wellness subscriptions today.</p>
      <a href="https://apps.apple.com/us/app/passworth/id6753592317" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center rounded-lg bg-primary px-6 py-3 text-white shadow hover:bg-primary-600">Download for Free</a>
    </section>

  </main>
  
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">{JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'PassWorth',
    url: 'https://passworth.plucury.me/',
    logo: 'https://passworth.plucury.me/images/passworth-icon.png',
    description: 'Track and compare any membership subscription. Monitor usage to maximize value and savings from passes, punch cards, and recurring memberships.',
    sameAs: []
  })}</script>
  
  <script type="application/ld+json">{JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'PassWorth',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'iOS',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.8',
      ratingCount: '150'
    },
    description: 'Track and compare any membership subscription or pass. Monitor your usage to maximize value and savings. Make smarter decisions for memberships, punch cards, and recurring subscriptions.',
    featureList: [
      'Compare membership costs and find the best deal',
      'Track usage and maximize membership value',
      'Calculate cost per visit and break-even points',
      'Monitor savings across all subscriptions',
      'Support for any membership or subscription service',
      'Punch card and time-based pass comparison',
      'Multi-currency support'
    ],
    screenshot: 'https://passworth.plucury.me/images/hero.png',
    downloadUrl: 'https://apps.apple.com/us/app/passworth/id6753592317'
  })}</script>
  
  <script type="application/ld+json">{JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { 
        '@type': 'Question', 
        name: 'What is PassWorth and how does it help me save money?', 
        acceptedAnswer: { 
          '@type': 'Answer', 
          text: 'PassWorth is an iOS membership tracker app that helps you compare any membership pass costs. It shows you which subscription or punch card offers the best value, tracks your usage to maximize savings, and motivates you to use your memberships more often. Works great for gyms, studios, clubs, and any recurring membership service.' 
        } 
      },
      { 
        '@type': 'Question', 
        name: 'Can I track multiple memberships at the same time?', 
        acceptedAnswer: { 
          '@type': 'Answer', 
          text: 'Yes! Track unlimited memberships across any subscription-based service with punch cards or time-based passes. Compare them all to see which gives you the best deal. Perfect for gyms, studios, clubs, classes, and more.' 
        } 
      },
      { 
        '@type': 'Question', 
        name: 'How does usage tracking help me get more value?', 
        acceptedAnswer: { 
          '@type': 'Answer', 
          text: 'By showing your real-time cost per visit and break-even point, PassWorth motivates you to use your membership more frequently. The more you go, the lower your average cost becomes, maximizing your return on investment.' 
        } 
      },
      { 
        '@type': 'Question', 
        name: 'Does it support different currencies and pricing models?', 
        acceptedAnswer: { 
          '@type': 'Answer', 
          text: 'Yes. Set your preferred currency in settings. PassWorth works with all pricing models including monthly subscriptions, annual memberships, punch cards, and pay-per-visit options.' 
        } 
      }
    ]
  })}</script>
  
  <script type="application/ld+json">{JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'PassWorth Membership Calculator',
    url: 'https://passworth.plucury.me/#how-it-works',
    description: 'Free online calculator to compare gym membership costs, punch cards, and time-based passes',
    browserRequirements: 'Requires JavaScript',
    applicationCategory: 'FinanceApplication'
  })}</script>
</BaseLayout>
